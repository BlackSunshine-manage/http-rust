{
    "configurations": [
      {
          "type": "lldb",
          "request": "launch",
          "name": "Debug Rust",
          "cargo": {
             "args": ["build", "--manifest-path", "${fileDirname}/../Cargo.toml"]
          }
      },
      {
            "name": "Debug autoupdated executable rust application",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "run",
                    "--bin=https-an"
                ]
            },
            "args": []
        }
    ]
}